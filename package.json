{
  "name": "bbsbh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tally Baseball companion for scorekeeping, delayed watching, and baseball research.",
  "scripts": {
    "dev": "vite",
    "dev:lab": "vite --open /identity-lab?nointro",
    "dev:2": "vite --port 5172",
    "dev:3": "vite --port 5171",
    "dev:4": "vite --port 5170",
    "dev:5": "vite --port 5169",
    "build": "vite build",
    "preview": "vite preview",
    "preview:2": "vite preview --port 4172",
    "preview:3": "vite preview --port 4171",
    "preview:4": "vite preview --port 4170",
    "preview:5": "vite preview --port 4169",
    "lint": "eslint . && node scripts/check-caps.mjs && node scripts/check-name-casing.mjs && node scripts/check-typography.mjs && node scripts/check-focus-ring.mjs && node scripts/check-strike-links.mjs && node scripts/check-contrast.mjs && node scripts/check-claude-md.mjs && node scripts/check-report-pages.mjs && node scripts/check-skeleton-ball-frames.mjs && node scripts/check-stamp-surfaces.mjs && node scripts/check-spoiler-manifest.mjs && node scripts/check-dir-size.mjs && node scripts/check-file-size.mjs && node scripts/check-dead-exports.mjs",
    "check:caps": "node scripts/check-caps.mjs",
    "check:name-casing": "node scripts/check-name-casing.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:focus-ring": "node scripts/check-focus-ring.mjs",
    "check:strike-links": "node scripts/check-strike-links.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:report-pages": "node scripts/check-report-pages.mjs",
    "check:skeleton-ball-frames": "node scripts/check-skeleton-ball-frames.mjs",
    "check:stamp-surfaces": "node scripts/check-stamp-surfaces.mjs",
    "check:dir-size": "node scripts/check-dir-size.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:dead-exports": "node scripts/check-dead-exports.mjs",
    "check:dist-dev": "node scripts/check-dist-dev-routes.mjs",
    "compress-logos": "node scripts/compress-logos.mjs && node scripts/gen-logo-art.mjs",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-reporter=dot \"test/**/*.test.js\"",
    "test:verbose": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" \"test/**/*.test.js\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.7",
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource/big-shoulders-display": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/og": "1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
