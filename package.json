{
  "name": "bbsbh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tally Baseball companion for scorekeeping, delayed watching, and baseball research.",
  "scripts": {
    "dev": "vite",
    "dev:lab": "vite --open /identity-lab?nointro",
    "dev:2": "vite --port 5172",
    "dev:3": "vite --port 5171",
    "dev:4": "vite --port 5170",
    "dev:5": "vite --port 5169",
    "build": "node scripts/gen-sitemap.mjs && vite build",
    "preview": "vite preview",
    "preview:2": "vite preview --port 4172",
    "preview:3": "vite preview --port 4171",
    "preview:4": "vite preview --port 4170",
    "preview:5": "vite preview --port 4169",
    "lint": "node scripts/check-all.mjs",
    "check:feed-shape-drift": "node scripts/check-feed-shape-drift.mjs",
    "check:dist-dev": "node scripts/check-dist-dev-routes.mjs",
    "check:sw-learn": "node scripts/check-sw-learn-fallback.mjs",
    "compress-logos": "node scripts/compress-logos.mjs && node scripts/gen-logo-art.mjs",
    "gen:ballpark-thumbs": "node scripts/gen-ballpark-thumbs.mjs",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test --test-reporter=dot \"test/**/*.test.js\"",
    "test:verbose": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" \"test/**/*.test.js\"",
    "e2e": "playwright test",
    "visual": "playwright test -c playwright.visual.config.js",
    "gen:sitemap": "node scripts/gen-sitemap.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.22.0",
    "@clerk/clerk-react": "^5.61.9",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
