{
  "$schema": "https://unpkg.com/knip@5.88.1/schema.json",
  "entry": [
    "api/**/*.js!",
    "scripts/**/*.mjs!",
    "test/**/*.test.js",
    ".claude/hooks/*.mjs!",
    ".claude/skills/**/*.mjs!",
    ".design-sync/build/*.mjs!",
    "e2e/shots/*.mjs!",
    "tools/**/*.mjs!"
  ],
  "ignore": [
    ".scratch/**"
  ],
  "ignoreDependencies": [
    "@fontsource/.*",
    "playwright"
  ],
  "project": [
    "src/**/*.{js,jsx,mjs}!",
    "api/**/*.js!"
  ]
}
