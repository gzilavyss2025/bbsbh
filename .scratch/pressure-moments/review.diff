+.tensest__picker .vsteam__strip::-webkit-scrollbar-button {
+  display: none;
+}
+.tensest__picker .vsteam__strip::-webkit-scrollbar {
+  height: 6px;
+}
+.tensest__picker .vsteam__strip::-webkit-scrollbar-track {
+  background: var(--surface-inset);
+  margin-inline: var(--space-3);
+}
+.tensest__picker .vsteam__strip::-webkit-scrollbar-thumb {
+  background: var(--border-stamped);
+  border-radius: 0;
+}
+.tensest__picker .vsteam__strip::-webkit-scrollbar-thumb:hover {
+  background: var(--graphite);
+}
+
+
+/* The last row's ▶ tap area reaches 3px under the table; clip it rather than scroll. */
+.tensest__section .table {
+  overflow-y: clip;
+}
+
+/* The picked club's side won or lost the at-bat (swingFor): a wash light enough that the row still
+   reads as paper. */
+.tensest tbody tr.tensest__row--up {
+  background: color-mix(in srgb, var(--accent-positive) 7%, transparent);
+}
+.tensest tbody tr.tensest__row--down {
+  background: color-mix(in srgb, var(--accent-negative) 7%, transparent);
+}
+
+.tensest__nobreak {
+  white-space: nowrap;
+}
+
+/* The record, right of the switch: a stamped box holding the count over a tally strip,
+   one square per at-bat in its row's colour (a scorebook's tick marks). */
+.tensest__sidebar {
+  margin: var(--space-2) var(--space-3) 0;
+}
+.tensest__sidebar .tensest__side {
+  margin: 0;
+}
+.tensest__record {
+  margin-inline-start: auto;
+  padding: var(--space-2) var(--space-3);
+  /* A plain ink frame: it sits inside a stamped card, so no second hard shadow. */
+  border: var(--bw-hair) solid var(--border-stamped);
+  text-align: right;
+}
+.tensest__recordline {
+  margin: 0 0 var(--space-1);
+}
+.tensest__recordlabel {
+  font-family: var(--font-display);
+  font-size: var(--fs-label);
+  color: var(--text-muted);
+}
+.tensest__recordfig {
+  font-family: var(--font-mono);
+  font-size: var(--fs-num-lg);
+  color: var(--text-heading);
+}
+.tensest__tally {
+  display: block;
+}
+.tensest__tick {
+  display: inline-block;
+  width: 9px;
+  height: 9px;
+  margin-inline-start: 2px;
+  vertical-align: top;
+  border: var(--bw-hair) solid var(--border-stamped);
+}
+.tensest__tick--up {
+  background: var(--accent-positive);
+}
+.tensest__tick--down {
+  background: var(--accent-negative);
+}
+@media (max-width: 739.98px) {
+  .tensest__record {
+    margin-inline-start: 0;
+    text-align: left;
+  }
+  .tensest__tick {
+    margin-inline: 0 2px;
+  }
+}
+
+/* The record against MLB, in words; green or red only past the 5-point margin. */
+.tensest__versus {
+  margin: 0 0 var(--space-1);
+  font-family: var(--font-display);
+  font-size: var(--fs-label);
+  color: var(--text-muted);
+}
+.tensest__versus--up {
+  color: var(--accent-positive);
+}
+.tensest__versus--down {
+  color: var(--accent-negative);
+}
