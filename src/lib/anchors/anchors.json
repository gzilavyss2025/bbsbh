    "tier": "1 = nearly everyone knows it, 2 = most baseball fans, 3 = niche (never picked unless nothing else fits)",
    "kind": "'static' never changes, 'volatile' can change next year",
    "status": "'verified' | 'unverified' (caveat asks for a re-check first) | 'disputed' | 'stale' | 'unsourced'",
    "caveat": "what a writer must not claim"
  },
