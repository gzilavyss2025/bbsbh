# dependencies
node_modules
.pnpm-store

# build output
dist
dist-ssr
*.local

# vite / pwa generated
dev-dist

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# vercel
.vercel

# fetched Game Notes PDFs (large, re-fetch fresh per session — see .scratch/game-notes/README.md)
.scratch/game-notes/pdfs/
# …and the curation scan's extracted dossiers (issue #774): re-run
# `scan-game-notes-insights.mjs extract` to rebuild one. The hand
# classification beside them (verdicts-*.json) IS committed — it is the
# provenance for public/data/game-notes-corroboration.json.
.scratch/game-notes/insights/dossier-*.json

# the mono-logo contact sheet (a --sheet artifact for eyeballing a regeneration,
# not app content — see scripts/gen-mono-logos.mjs)
.scratch/mono-logos/

# the callout audit's report + run logs (an analysis artifact for tuning the
# rubric, not app data — see scripts/audit-callouts.mjs)
.scratch/callout-audit/

# cached full-season transaction-wire dumps from the level-tenure benchmark
# research (62MB, over GitHub's file-size warning threshold) — re-fetch via
# .scratch/level-benchmarks/dates.mjs or org-and-timing.mjs if needed, ~13
# cheap season-long pulls, see docs/level-tenure-benchmark.md
.scratch/level-benchmarks/txn-cache.json

# cached MLB and Triple-A season splits from the blockage research (7MB
# together) and the row sets derived from them — every one is rebuilt by
# `node pull-mlb.mjs && node pull-milb-field.mjs && node build.mjs`, and both
# pulls resume, see docs/price-the-blockage.md
.scratch/blockage/mlb-cache.json
.scratch/blockage/milb-field-cache.json
.scratch/blockage/stays.json
.scratch/blockage/rows.json
.scratch/blockage/hitters.json

# cached full-season transaction-wire dump (2008-2024, 52MB) backing the exit-
# reason join (join-txn.mjs) - rebuild via `node pull-txn.mjs`, resumable
.scratch/blockage/txn-season-cache.json

# a stray output directory a script creates when its destination path resolves
# to undefined (e.g. `--out $UNSET_VAR`). Never app content; one such file was
# committed by accident once. Ignored so the next mistake stays local.
undefined/

# team-success spike #5: the raw statsapi sweep (70 MB) and the assembled panel
# (51 MB) rebuild from scratch in about two minutes via
# .scratch/team-success/build-october-texture.mjs. Only the distilled
# october-texture-findings.json is worth committing.
.scratch/team-success/october-texture-cache.json
.scratch/team-success/october-texture.json

# research DuckDB catalog: rebuilds in under a second from the JSON panels
# via `node scripts/research-db.mjs`. It stores view definitions only, no
# copied data, so there is nothing here worth committing.
.scratch/research.duckdb
.scratch/research.duckdb.wal
