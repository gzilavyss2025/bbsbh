{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "ignoreCommand": "scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "rewrites": [
    { "source": "/learn", "destination": "/api/page" },
    { "source": "/learn/:slug", "destination": "/api/page?slug=:slug" },
    { "source": "/player/:id", "destination": "/api/preview?route=player&id=:id" },
    { "source": "/team/:id/leaders", "destination": "/api/preview?route=team-leaders&id=:id" },
    { "source": "/team/:id/roster", "destination": "/api/preview?route=team-roster&id=:id" },
    { "source": "/team/:id/games", "destination": "/api/preview?route=team-games&id=:id" },
    { "source": "/team/:id/numbers", "destination": "/api/preview?route=team-numbers&id=:id" },
    { "source": "/team/:id/minors", "destination": "/api/preview?route=team-minors&id=:id" },
    { "source": "/team/:id", "destination": "/api/preview?route=team&id=:id" },
    { "source": "/leaders/org/:orgId", "destination": "/api/preview?route=leaders-org&orgId=:orgId" },
    { "source": "/leaders/:scope", "destination": "/api/preview?route=leaders&scope=:scope" },
    { "source": "/leaders", "destination": "/api/preview?route=leaders" },
    { "source": "/standings", "destination": "/api/preview?route=standings" },
    { "source": "/prospects", "destination": "/api/preview?route=prospects" },
    { "source": "/rehab", "destination": "/api/preview?route=rehab" },
    { "source": "/about", "destination": "/api/preview?route=about" },
    { "source": "/logos", "destination": "/api/preview?route=logos" },
    { "source": "/team-records", "destination": "/api/preview?route=team-records" },
    { "source": "/fouls", "destination": "/api/preview?route=fouls" },
    { "source": "/milestones", "destination": "/api/preview?route=milestones" },
    { "source": "/umpires", "destination": "/api/preview?route=umpires" },
    { "source": "/awards", "destination": "/api/preview?route=awards" },
    { "source": "/postseason-history", "destination": "/api/preview?route=postseason-history" },
    { "source": "/postseason-leaders", "destination": "/api/preview?route=postseason-leaders" },
    { "source": "/trade-deadline", "destination": "/api/preview?route=trade-deadline" },
    { "source": "/all-star-rosters", "destination": "/api/preview?route=all-star-rosters" },
    { "source": "/all-star-legacy", "destination": "/api/preview?route=all-star-legacy" },
    { "source": "/logbook", "destination": "/api/preview?route=logbook" },
    { "source": "/first-scorebook", "destination": "/api/preview?route=first-scorebook" },
    { "source": "/photos", "destination": "/api/preview?route=photos" },
    { "source": "/rundown", "destination": "/api/preview?route=rundown" },
    { "source": "/attendance", "destination": "/api/preview?route=attendance" },
    { "source": "/pace", "destination": "/api/preview?route=pace" },
    { "source": "/farm", "destination": "/api/preview?route=farm-system" },
    { "source": "/bullpens", "destination": "/api/preview?route=bullpens" },
    { "source": "/:date(\\d{8})/:matchup/:section", "destination": "/api/preview?route=game&date=:date&matchup=:matchup&section=:section" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
